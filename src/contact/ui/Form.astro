---
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.send);
// 👈 esto solo en desarrollo

if (result?.data && typeof result.data === "object" && "success" in result.data) {
  return Astro.redirect("/gracias")
};

---

<form
  class="shadow-lg p-8 space-y-6 max-w-lg bg-white rounded-lg dark:bg-slate-800 text-gray-500"
  method="post"
  action={actions.send}
  id="contact-form"
>
  <legend class="text-xl font-bold text-gray-800 mb-4 dark:text-white">
    Estoy interesado en
  </legend>

  <!-- Hidden subject field -->
  <input type="hidden" name="subject" id="subject-field" />

  <div class="flex flex-wrap gap-3" id="subject-buttons">
    {["UI/UX Design", "Desarrollo móvil", "Sistemas CRM", "Optimización", "Otros"].map(subject => (
      <button
        type="button"
        class="subject-btn border border-sky-900 px-4 py-2 rounded-full text-sky-900 hover:bg-sky-900 hover:text-white transition-all duration-200 dark:border-sky-600 dark:text-sky-600 dark:hover:bg-sky-600 dark:hover:text-white cursor-pointer"
        data-value={subject}
      >
        {subject}
      </button>
    ))}
  </div>

  <!-- Resto del formulario -->
  <!-- Nombre -->
  <div class="grid gap-2">
    <label for="name" class="font-semibold text-gray-700 dark:text-gray-300">Nombre</label>
    <input type="text" id="name" name="name" placeholder="Jhon Smith" class="border-b border-gray-400 px-2 py-2 focus:border-sky-500 outline-none transition-all duration-200 dark:border-b-sky-600 dark:focus:border-sky-400 dark:placeholder:text-slate-600" />
  </div>

  <!-- Email -->
  <div class="grid gap-2">
    <label for="email" class="font-semibold text-gray-700 dark:text-gray-300">Email</label>
    <input type="email" id="email" name="email" placeholder="example@gmail.com" class="border-b border-gray-400 px-2 py-2 focus:border-sky-500 outline-none transition-all duration-200 dark:border-b-sky-600 dark:focus:border-sky-400 dark:placeholder:text-slate-600" />
  </div>

  <!-- Mensaje -->
  <div class="grid gap-2">
    <label for="message" class="font-semibold text-gray-700 dark:text-gray-300">Mensaje</label>
    <textarea id="message" name="message" placeholder="Escribe tu mensaje aquí..." class="border-b border-gray-400 px-2 py-2 focus:border-sky-500 outline-none transition-all duration-200 resize-none h-24 dark:border-b-sky-600 dark:focus:border-sky-400 dark:placeholder:text-slate-600"></textarea>
  </div>

  <input
    type="submit"
    value="Enviar Mensaje"
    class="w-full bg-sky-900 text-white py-2 rounded-lg font-semibold hover:bg-sky-800 transition-all duration-200 cursor-pointer dark:bg-sky-600 dark:hover:bg-sky-500 dark:text-white"
  />
</form>


<script  src="../utils/subjectButtons.ts"></script>
<script src="../utils/validateForm.ts"></script>

