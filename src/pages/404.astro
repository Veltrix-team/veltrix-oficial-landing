---

import "../common/styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página no encontrada</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <section class="min-h-screen flex flex-col md:flex-row px-4 md:px-20 items-center justify-center bg-gradient-to-br from-slate-900 to-gray-900">

        <div class="text-center md:text-left mb-10 md:mb-0 md:mr-20">
            <h1 class="text-8xl font-bold text-sky-400 mb-4">404</h1>
            <h2 class="text-3xl font-semibold text-slate-200 mb-6">¡Ups! Página no encontrada</h2>
            <p class="text-lg text-slate-400 mb-8 max-w-md">
                Parece que te has perdido en el espacio. La página que buscas no existe o ha sido movida.
            </p>
            <a href="/" class="inline-flex items-center px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-medium rounded-lg transition duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Regresar al inicio
            </a>
        </div>

        <div class="relative">
            <!-- Imagen con width grande pero height automático para mantener proporciones -->
            <img src="/vex-404.png" alt="Astronauta perdido en el espacio" class="w-full max-w-[32rem] h-auto animate-float">
            <div class="absolute -bottom-8 -left-8 w-32 h-32 bg-sky-800 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-pulse"></div>
            <div class="absolute -top-8 -right-8 w-32 h-32 bg-indigo-800 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-pulse delay-300"></div>
        </div>

    </section>

    <style>
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        
        /* Asegurar buen tamaño en diferentes dispositivos */
        @media (max-width: 768px) {
            .relative {
                width: 100%;
                max-width: 24rem;
                margin: 0 auto;
            }
        }
    </style>
</body>
</html>