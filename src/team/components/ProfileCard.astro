---

import { Icon } from 'astro-icon/components';
interface Props {
    userImage: string;
    name: string;
    title: string;
    description: string;
    github:string;
    instagram?:string;
}

const { userImage, name, title, description, github, instagram } = Astro.props;
---

<article
    class="bg-gray-100 w-100 flex flex-col items-center text-center shadow-xl p-6 rounded-lg transition-transform duration-300 hover:shadow-2xl dark:bg-slate-800"
>
    <div class="w-25 h-25 rounded-full overflow-hidden shadow-lg">
        <img src={userImage} alt={name} class="object-cover w-full h-full" />
    </div>

    <div class="pt-4">
        <h2 class="text-2xl text-sky-900 font-bold mb-2 dark:text-sky-600">{name}</h2>
        <h3 class="text-xl text-sky-800 mb-4">{title}</h3>
        <p class="leading-8 text-gray-500">{description}</p>
    </div>

    
    <div class="flex gap-4 mt-4 text-sky-950 dark:text-sky-600">
        
        <a href={instagram} class="hover:text-sky-600 transition-colors" target="_blank">
            <Icon name="social/instagram" width={25} height={25} class="fill-current" />
        </a>
      
        <a href={github} class="hover:text-sky-600 transition-colors" target="_blank">
            <Icon name="social/github" width={25} height={25} class="fill-current" />
        </a>
       
        <!-- <Icon name="social/linkedin" width={25} height={25} class="fill-current" /> -->
    </div>
</article>